// Copy this file to secrets.h and fill in your actual credentials
// DO NOT commit secrets.h to version control!

#ifndef SECRETS_H
#define SECRETS_H

// WiFiManager config-portal credentials (the AP each board hosts during WiFi setup only)
#define AP_SSID "Print-n-Prick"
#define AP_PASSWORD "your-portal-password"
#define TZT_AP_SSID "TZT_Display"
#define TZT_AP_PASSWORD "your-portal-password"

// OpenWeatherMap API key and location (latitude/longitude for local weather)
#define WEATHER_API_KEY "your-openweathermap-api-key"
#define WEATHER_LATITUDE 0.0
#define WEATHER_LONGITUDE 0.0

// Web interface / API password (Main + TZT)
#define WEB_PASSWORD "your-web-password"

// OTA Update Password
#define OTA_PASSWORD "your-secure-ota-password"

// Raspberry Pi backend API key (sent as X-API-Key header). Must match
// PRICK_N_PRINT_API_KEY in the environment where raspberrypi/app.py runs.
#define BACKEND_API_KEY "your-backend-api-key"

#endif // SECRETS_H
